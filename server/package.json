    async def get_screens_with_publishing_id(self, id: str, conn: Optional[Any] = None, place_id: Optional[str] = None) -> List[str]:
        try:
            query = {
                'values': [id],
            }
            if place_id:
                query['text'] = 'SELECT screen_id FROM cms_screen_distribution WHERE id = $1 AND place_id = $2'
                query['values'].append(place_id)
            else:
                query['text'] = 'SELECT screen_id FROM cms_screen_distribution WHERE id = $1'

            rows = await self.db_service.select_rows(query, conn)
            screen_ids = [row['screen_id'] for row in rows]
            logger.info(f"[PublishingService][get_screens_with_publishing_id] {len(screen_ids)} screen ids for distribution id: {id}, {json.dumps(screen_ids)}")
            return screen_ids
        except Exception as e:
            logger.error(f"[PublishingService][get_screens_with_publishing_id] Fail to get screens ids by distribution id: {id}, {str(e)}")
            return []

