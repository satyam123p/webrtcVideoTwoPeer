# Placeholder for dbService (assumes PostgreSQL)
class DBService:
    def __init__(self, connection_params: Dict[str, str]):
        self.conn_params = connection_params

    async def select_rows(self, query: Dict[str, Any], conn: Optional[Any] = None) -> List[Dict[str, Any]]:
        connection = conn or psycopg2.connect(**self.conn_params)
        try:
            with connection.cursor() as cursor:
                cursor.execute(query['text'], query['values'])
                columns = [desc[0] for desc in cursor.description]
                rows = [dict(zip(columns, row)) for row in cursor.fetchall()]
                return rows
        finally:
            if not conn:
                connection.close()

    async def update_row(self, query: Dict[str, Any], conn: Optional[Any] = None) -> Dict[str, Any]:
        connection = conn or psycopg2.connect(**self.conn_params)
        try:
            with connection.cursor() as cursor:
                cursor.execute(query['text'], query['values'])
                connection.commit()
                columns = [desc[0] for desc in cursor.description] if cursor.description else []
                rows = [dict(zip(columns, row)) for row in cursor.fetchall()] if cursor.description else []
                return {'rows': rows}
        finally:
            if not conn:
                connection.close()

    async def delete_rows(self, query: Dict[str, Any], conn: Optional[Any] = None) -> None:
        connection = conn or psycopg2.connect(**self.conn_params)
        try:
            with connection.cursor() as cursor:
                cursor.execute(query['text'], query['values'])
                connection.commit()
        finally:
            if not conn:
                connection.close()

# Enum for Type constants
class Type(Enum):
    CONTENT = 'CONTENT'
    PLAYLIST = 'PLAYLIST'
    SCHEDULE = 'SCHEDULE'
    PROGRAM = 'PROGRAM'
    SYNCPLAY = 'SYNCPLAY'
    GENERAL = 'GENERAL'

class PublishingService:
    def __init__(self, region: str = 'ap-northeast-1', db_instance: Optional[DBService] = None, 
                 bucket: str = '', sqs_url: str = '', delay_batch_time: int = 10):
        self.dynamo_db = DynamoDBService.get_instance(region)
        self.table_name = 'fcms-screens-publishing-dm'
        self.s3_service = S3Service(region)
        self.sqs_service = SQSService(region)
        self.db_service = db_instance or DBService({})  # Replace with actual connection params
        self.bucket = bucket
        self.sqs_url = sqs_url
        self.delay_batch_time = delay_batch_time

    async def get_shared_status_by_content_id(self, id: str) -> List[Dict[str, Any]]:
        try:
            result = await self.db_service.select_rows({
                'text': 'SELECT is_shared, place_id FROM cms_content WHERE content_id = $1',
                'values': [id],
            })
            if result:
                result[0]['originalPlaceId'] = result[0]['place_id']
                result[0]['isShared'] = result[0]['is_shared']
                return result
            return []
        except Exception as e:
            logger.error(f"[PublishingService][get_shared_status_by_content_id] Failed to get shared status: {str(e)}")
            return []

