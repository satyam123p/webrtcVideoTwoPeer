    async def get_content(self, content_id: str) -> Optional[Dict[str, Any]]:
        try:
            row_data = await self.db_service.select_rows({
                'text': '''
                    SELECT a.*, b.version, b.media_type, b.total_size, b.play_time, b.thumbnail_id,
                           b.main_file_id, c.file_name, b.resolution, b.orientation
                    FROM cms_content a
                    JOIN cms_content_version b ON a.content_id = b.content_id
                    LEFT JOIN cms_file c ON b.main_file_id = c.file_id
                    WHERE a.content_id = $1 AND b.is_active = TRUE
                ''',
                'values': [content_id],
            })
            if not row_data:
                return None

            content = row_data[0]
            file_data = await self.db_service.select_rows({
                'text': 'SELECT * FROM cms_file WHERE file_id = $1',
                'values': [content['main_file_id']],
            })
            if file_data:
                content['mainFileName'] = file_data[0]['file_name']
                content['file'] = file_data[0]

            return content
        except Exception as e:
            logger.error(f"[PublishingService][get_content] Fail to get content by content id: {content_id}, {str(e)}")
            return None

    async def get_playlist(self, playlist_id: str) -> Dict[str, Any]:
        playlist = {}
        try:
            query = '''
                SELECT a.*, b.version, b.total_size, b.play_time, b.is_shuffle, b.out_effect, b.in_effect
                FROM cms_playlist a
                JOIN cms_playlist_version b ON a.playlist_id = b.playlist_id
                WHERE a.playlist_id = $1 AND b.is_active = TRUE
            '''
            playlist_result = await self.db_service.select_rows({
                'text': query,
                'values': [playlist_id],
            })
            logger.info(f"[PublishingService][get_playlist] playlistResult: {json.dumps(playlist_result)}")

            if playlist_result:
                playlist = playlist_result[0].copy()
                version = playlist['version']
                contents_query = '''
                    SELECT a.*, b.content_name, c.media_type, c.main_file_id, c.thumbnail_id, c.total_size,
                           d.file_name, d.file_width, d.file_height, d.file_rotation, d.file_duration, d.file_hash,
                           (SELECT ARRAY_AGG(tag_key) FROM cms_playlist_tag_condition
                            WHERE playlist_id = a.playlist_id AND content_id = a.content_id
                            AND content_order = a.content_order AND sync_id = a.sync_id
                            AND tag_condition_type = 'ALLOW') AS allow_tags,
                           (SELECT ARRAY_AGG(tag_key) FROM cms_playlist_tag_condition
                            WHERE playlist_id = a.playlist_id AND content_id = a.content_id
                            AND content_order = a.content_order AND sync_id = a.sync_id
                            AND tag_condition_type = 'SKIP') AS skip_tags,
                           (SELECT DISTINCT tag_apply_type FROM cms_playlist_tag_condition
                            WHERE playlist_id = a.playlist_id AND content_id = a.content_id
                            AND content_order = a.content_order AND sync_id = a.sync_id
                            AND tag_condition_type = 'ALLOW') AS allow_tags_condition,
                           (SELECT DISTINCT tag_apply_type FROM cms_playlist_tag_condition
                            WHERE playlist_id = a.playlist_id AND content_id = a.content_id
                            AND content_order = a.content_order AND sync_id = a.sync_id
                            AND tag_condition_type = 'SKIP') AS skip_tags_condition
                    FROM cms_playlist_relation_content a
                    JOIN cms_content b ON a.content_id = b.content_id
                    JOIN cms_content_version c ON a.content_id = c.content_id
                    JOIN cms_file d ON c.main_file_id = d.file_id
                    WHERE a.playlist_id = $1 AND a.version = $2
                    ORDER BY a.content_order ASC
                '''
                contents = await self.db_service.select_rows({
                    'text': contents_query,
                    'values': [playlist_id, version],
                })
                logger.info(f"[PublishingService][get_playlist] contents: {json.dumps(contents)}")

                for content in contents:
                    if not content.get('allow_tags') or not content.get('allow_tags_condition'):
                        content.pop('allow_tags', None)
                        content.pop('allow_tags_condition', None)
                    if not content.get('skip_tags') or not content.get('skip_tags_condition'):
                        content.pop('skip_tags', None)
                        content.pop('skip_tags_condition', None)

                if contents:
                    playlist['contents'] = contents

                playlist['userName'] = playlist.get('updater_name', '')

                sub_playlist_query = '''
                    SELECT * FROM cms_playlist_relation_sub_playlist
                    WHERE playlist_id = $1 AND version = $2
                    ORDER BY content_order
                '''
                sub_playlists = await self.db_service.select_rows({
                    'text': sub_playlist_query,
                    'values': [playlist_id, version],
                })
                logger.info(f"[PublishingService][get_playlist] subPlaylists: {json.dumps(sub_playlists)}")

                if sub_playlists:
                    playlist['contents'] = playlist.get('contents', []) + sub_playlists
                    playlist['contents'].sort(key=lambda x: x['content_order'])

                    for index in range(len(playlist['contents']) - 1, -1, -1):
                        if playlist['contents'][index].get('sub_playlist_id'):
                            sub_contents_query = '''
                                SELECT a.*, b.content_name, c.media_type, c.main_file_id, c.thumbnail_id,
                                       c.total_size, d.file_name, d.file_width, d.file_height, d.file_rotation,
                                       d.file_duration, d.file_hash
                                FROM cms_playlist_relation_content a
                                JOIN cms_content b ON a.content_id = b.content_id
                                JOIN cms_content_version c ON a.content_id = c.content_id
                                JOIN cms_file d ON c.main_file_id = d.file_id
                                WHERE a.playlist_id = $1
                                AND a.version = (SELECT version FROM cms_playlist_version WHERE playlist_id = $1)
                                ORDER BY a.content_order ASC
                            '''
                            sub_contents = await self.db_service.select_rows({
                                'text': sub_contents_query,
                                'values': [playlist['contents'][index]['sub_playlist_id']],
                            })
                            if sub_contents:
                                logger.info(f"[PublishingService][get_playlist] subContents: {json.dumps(sub_contents)}")
                                for sub_content in sub_contents:
                                    sub_content['content_order'] += playlist['contents'][index]['content_order']
                                playlist['contents'][index:index+1] = sub_contents

                    for index, content in enumerate(playlist['contents']):
                        content['content_order'] = index

            logger.info(f"[PublishingService][get_playlist] playlist: {json.dumps(playlist)}")
            return playlist
        except Exception as e:
            logger.error(f"[PublishingService][get_playlist] Fail to get playlist by playlist id: {playlist_id}, {str(e)}")
            return {}

    async def get_playlist_ids_by_content_id(self, content_id: str) -> List[str]:
        try:
            playlist_ids = await self.db_service.select_rows({
                'text': 'SELECT DISTINCT playlist_id FROM cms_playlist_relation_content WHERE content_id = $1',
                'values': [content_id],
            })
            ids = [row['playlist_id'] for row in playlist_ids]
            logger.info(f"[PublishingService][get_playlist_ids_by_content_id] contentId: {content_id}, playlistIds: {json.dumps(ids)}")
            return ids
        except Exception as e:
            logger.error(f"[PublishingService][get_playlist_ids_by_content_id] Fail to get playlist ids by content id: {content_id}, {str(e)}")
            raise

    async def get_playlist_ids_by_sub_playlist_ids(self, sub_playlist_ids: List[str]) -> List[str]:
        try:
            placeholders = ', '.join([f'${i+1}' for i in range(len(sub_playlist_ids))])
            playlist_ids = await self.db_service.select_rows({
                'text': f'SELECT DISTINCT playlist_id FROM cms_playlist_relation_sub_playlist WHERE sub_playlist_id IN ({placeholders})',
                'values': sub_playlist_ids,
            })
            ids = [row['playlist_id'] for row in playlist_ids]
            logger.info(f"[PublishingService][get_playlist_ids_by_sub_playlist_ids] subPlaylistIds: {sub_playlist_ids}, playlistIds: {json.dumps(ids)}")
            return ids
        except Exception as e:
            logger.error(f"[PublishingService][get_playlist_ids_by_sub_playlist_ids] Fail to get playlist ids by subPlaylistIds: {sub_playlist_ids}, {str(e)}")
            raise

    async def get_program_ids_by_content_id(self, content_id: str) -> List[str]:
        try:
            program_ids = await self.db_service.select_rows({
                'text': '''
                    SELECT DISTINCT program_id
                    FROM pms_program_relation_schedule
                    WHERE schedule_id IN (SELECT schedule_id FROM pms_schedule WHERE content_id = $1)
                    AND program_id != $1
                ''',
                'values': [content_id],
            })
            ids = [row['program_id'] for row in program_ids]
            logger.info(f"[PublishingService][get_program_ids_by_content_id] contentId: {content_id}, programIds: {json.dumps(ids)}")
            return ids
        except Exception as e:
            logger.error(f"[PublishingService][get_program_ids_by_content_id] Fail to get program ids by content id: {content_id}, {str(e)}")
            raise

    async def get_sync_group(self, id: str) -> List[Dict[str, Any]]:
        try:
            sync_data = await self.get_publishing_by_content_id(id)
            sync = []
            if sync_data:
                sync_id_key = 'popup_sync_id' if sync_data[0].get('popup_id') == id else 'sync_id'
                for data in sync_data:
                    sync_id = data.get(sync_id_key)
                    existing = next((group for group in sync if group['sync_id'] == sync_id), None)
                    if not existing:
                        sync.append({'sync_id': sync_id, 'screen_ids': []})
       
